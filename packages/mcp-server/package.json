{
  "name": "@veylqorix/mcp-server",
  "version": "0.1.0",
  "description": "MCP security server for AI coding agents: dependency, secret, and quality-check tools backed by the Veylqorix core.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bin": "./dist/bin.js"
  },
  "bin": {
    "veylqorix-mcp": "dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@veylqorix/core": "0.1.0",
    "zod": "4.6.7"
  }
}
