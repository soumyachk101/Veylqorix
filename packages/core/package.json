{
  "name": "@veylqorix/core",
  "version": "0.1.1",
  "description": "Security audit engine: project detection, scanners, policy evaluation, quality gate, and report generation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soumyachk101/Veylqorix.git"
  },
  "homepage": "https://github.com/soumyachk101/Veylqorix#readme",
  "type": "module",
  "engines": {
    "node": ">=20.18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scanners/*": {
      "types": "./dist/scanners/*.d.ts",
      "import": "./dist/scanners/*.js"
    },
    "./gate": {
      "types": "./dist/gate/index.d.ts",
      "import": "./dist/gate/index.js"
    },
    "./report": {
      "types": "./dist/report/index.d.ts",
      "import": "./dist/report/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
