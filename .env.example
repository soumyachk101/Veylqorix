# Veylqorix environment (no real credentials in this file)
#
# Copy to `.env` and fill in absolute paths for YOUR machine. Values below are
# placeholders only.

# --- API server (packages/api) -------------------------------------------
# Port the Veylqorix REST API listens on (default 4173).
VEYLQORIX_API_PORT=4173
# Comma/space-separated ABSOLUTE paths the API may register and scan. Leave
# empty to allow any path; set it to least-privilege roots in production.
VEYLQORIX_ALLOWED_ROOTS=/absolute/path/to/your/projects
# "1" runs scanners fully offline (skips npm/pip advisory network calls).
VEYLQORIX_OFFLINE=0
# "1" includes test/build quality checks in each scan (slower).
VEYLQORIX_INCLUDE_TESTS=0
# Per-scanner timeout in milliseconds.
VEYLQORIX_TIMEOUT_MS=120000

# --- Web dashboard (apps/web) --------------------------------------------
# Port the web app + /api proxy listens on.
VEYLQORIX_WEB_PORT=3000
# Base URL of the API the web proxy forwards /api/* to.
VEYLQORIX_API=http://localhost:4173
# Build-time base URL exposed to the dashboard client (Next.js-style). The
# static web app uses a same-origin /api proxy by default; set this only when
# serving the dashboard from a different origin than the API.
NEXT_PUBLIC_API_BASE=http://localhost:4173

# --- MCP server (packages/mcp-server) -------------------------------------
# Space-separated absolute roots every MCP tool is confined to.
VEYLQORIX_ROOTS=/absolute/path/to/your/projects
# (VEYLQORIX_OFFLINE and VEYLQORIX_TIMEOUT_MS above are shared with the API.)
