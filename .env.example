# Veylqorix environment (no real credentials in this file)
#
# Copy to `.env` and fill in absolute paths for YOUR machine. Values below are
# placeholders only. Every variable is documented with its safe default and
# who must set it ("optional" = a working default exists out of the box).

# --- API server (packages/api) -------------------------------------------
# [API operator] Port the Veylqorix REST API listens on.
# Default: 4173. Optional.
VEYLQORIX_API_PORT=4173
# [API operator] Comma/space-separated ABSOLUTE paths the API may register and
# scan. Empty = allow any path (default, dev-friendly); set least-privilege
# roots in production.
VEYLQORIX_ALLOWED_ROOTS=/absolute/path/to/your/projects
# [Shared] "1" runs scanners fully offline (skips npm/pip advisory network
# calls). Default: 0 (online). Optional.
VEYLQORIX_OFFLINE=0
# [API operator] "1" includes test/build quality checks in each scan (slower).
# Default: 0. Optional.
VEYLQORIX_INCLUDE_TESTS=0
# [Shared] Per-scanner timeout in milliseconds. Default: 120000. Optional.
VEYLQORIX_TIMEOUT_MS=120000
# [API operator] Bearer token for protected/remote mode. When set, every /api
# route (except GET /api/health) requires `Authorization: Bearer <token>` and
# the server binds to the host you configure. Provision per-operator tokens
# (never commit them) and rotate by restarting the API with a new value.
# Default: unset (loopback-only dev mode). Optional.
VEYLQORIX_API_TOKEN=
# [API operator] Bind address. Set only for remote/protected mode, and always
# together with VEYLQORIX_API_TOKEN (a non-loopback host without a token
# refuses to start). Default: unset (127.0.0.1). Optional.
VEYLQORIX_API_HOST=
# [API operator] Comma-separated exact origins the CORS allowlist admits
# (no wildcard, no credentials). Empty = no CORS headers are emitted.
# Default: empty. Optional.
VEYLQORIX_CORS_ORIGINS=
# [API operator] File where repositories and scan records persist across
# restarts (atomic writes; in-flight scans recover as INTERRUPTED).
# Default: ./.veylqorix-store.json (relative to the API process cwd). Optional.
VEYLQORIX_STORE_PATH=./.veylqorix-store.json
# [API operator] Maximum concurrent scans; excess requests get 429.
# Default: 2. Optional.
VEYLQORIX_MAX_CONCURRENT_SCANS=2
# [API operator] Maximum JSON request body in bytes (413 above it).
# Default: 1048576. Optional.
VEYLQORIX_BODY_LIMIT_BYTES=1048576
# [API operator] Maximum accepted length of `path`/`name`/`repoId` fields
# (400 above it). Default: 4096. Optional.
VEYLQORIX_MAX_FIELD_LENGTH=4096

# --- Web dashboard (apps/web) ---------------------------------------------
# [Web developer] Build-time base URL exposed to the dashboard client so the
# browser can talk to the API. Default (unset): same origin, i.e. the dev
# server's /api proxy or a gateway in front of the app. Set only when the
# dashboard is served from a different origin than the API.
NEXT_PUBLIC_API_BASE=http://localhost:4173
# NOTE: the web app does NOT read a web-port variable — `next dev` /
# `next start` listen on their standard ports (3000/3000 by default, or
# `-p`/PORT). The former VEYLQORIX_WEB_PORT / VEYLQORIX_API variables in
# .env.example were never consumed by the code and are removed.

# --- MCP server (packages/mcp-server) -------------------------------------
# [MCP host (AI agent config)] REQUIRED. Comma- or space-separated ABSOLUTE
# roots every MCP tool is confined to. The server fails closed: with
# VEYLQORIX_ROOTS unset it refuses to start (exit 1) - there is no cwd
# fallback. Set explicitly for least privilege.
VEYLQORIX_ROOTS=/absolute/path/to/your/projects
# (VEYLQORIX_OFFLINE and VEYLQORIX_TIMEOUT_MS above are shared with the API.)

# --- Rust engine (crates/veylqorix-engine) --------------------------------
# [Operator/CI] Absolute path to a prebuilt veylqorix-engine binary. Default:
# the TypeScript core walks up from the working directory to
# crates/target/release/veylqorix-engine (then debug/). If no binary is
# found the engine is reported SKIPPED, not an error. Optional.
VEYLQORIX_ENGINE=/absolute/path/to/veylqorix-engine

# --- Emergency override (pre-commit hooks) --------------------------------
# [Hook-installed repos only] "1" makes the Veylqorix pre-commit/pre-push
# hooks skip their scan exactly once, without uninstalling them.
# Default: unset (hooks always run). Optional; temporary use.
VEYLQORIX_OVERRIDE=
