digraph Roadmap {
  graph [rankdir=TB, bgcolor="#FBFAF7", pad="0.42", nodesep="0.42", ranksep="0.7", splines=ortho, fontname="Inter", label="Veylqorix  |  Eight-day build roadmap\nA target sequence for a showcase-ready MVP — validate every milestone", labelloc=t, labeljust=l, fontsize=24, fontcolor="#17213A"];
  node [shape=box, style="rounded,filled", fontname="Inter", fontsize=11, margin="0.2,0.17", color="#D6DAE4", fontcolor="#17213A", penwidth=1.5, width=2.65, height=1.05];
  edge [color="#6A768C", penwidth=1.5, arrowsize=0.7];
  d1 [label="DAY 1\nRepository audit\nArchitecture • baseline tests", fillcolor="#DDF7F3", color="#44CDBB"];
  d2 [label="DAY 2\nRust core + CLI\nScanner interfaces • tests", fillcolor="#DDF7F3", color="#44CDBB"];
  d3 [label="DAY 3\nReal scanners\nDependencies • secrets • SAST", fillcolor="#D7F7F0", color="#45CDBB"];
  d4 [label="DAY 4\nMCP + Skill\nValidate tools • client setup", fillcolor="#F0EBFF", color="#9B84F3"];
  d5 [label="DAY 5\nGitHub gate\nHooks • Actions • JSON / SARIF", fillcolor="#FFF3C8", color="#E3BE45"];
  d6 [label="DAY 6\nAPI + Dashboard\nActual scan data • findings UI", fillcolor="#FFF3C8", color="#E3BE45"];
  d7 [label="DAY 7\nIntegration hardening\nE2E • permissions • bug fixes", fillcolor="#D7F7F0", color="#45CDBB"];
  d8 [label="DAY 8\nShowcase preparation\nReproducible demo • docs • slides", fillcolor="#F0EBFF", color="#9B84F3"];
  {rank=same; d1; d2; d3; d4;}
  {rank=same; d5; d6; d7; d8;}
  d1 -> d2 -> d3 -> d4;
  d4 -> d5 [minlen=1];
  d5 -> d6 -> d7 -> d8;
}
