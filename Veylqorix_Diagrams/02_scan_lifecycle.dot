digraph ScanLifecycle {
  graph [rankdir=TB, bgcolor="#FBFAF7", pad="0.42", nodesep="0.5", ranksep="0.62", splines=ortho, fontname="Inter", label="Veylqorix  |  Security scan lifecycle\nFrom code change to evidence-backed decision", labelloc=t, labeljust=l, fontsize=24, fontcolor="#17213A"];
  node [shape=box, style="rounded,filled", fontname="Inter", fontsize=12, margin="0.22,0.16", color="#D6DAE4", fontcolor="#17213A", penwidth=1.5, width=2.7];
  edge [color="#6A768C", penwidth=1.5, arrowsize=0.7];
  start [label="1. Code Change\nWorking tree • staged diff • PR", fillcolor="#DDF7F3", color="#44CDBB"];
  detect [label="2. Detect Project\nLanguages • manifests • lockfiles", fillcolor="#DDF7F3", color="#44CDBB"];
  run [label="3. Run Applicable Scanners\nDependencies • secrets • SAST • tests", fillcolor="#D7F7F0", color="#45CDBB"];
  normalize [label="4. Normalize Findings\nSeverity • file/line • redacted evidence", fillcolor="#D7F7F0", color="#45CDBB"];
  policy [shape=diamond, label="5. Policy\nEvaluation", fillcolor="#FFF3C8", color="#E3BE45", width=1.8, height=1.0, margin="0.12,0.08"];
  pass [label="PASS\nRequired checks satisfied", fillcolor="#DFF5E8", color="#58B98A"];
  fail [label="BLOCK / FAIL\nBlocking finding or required check error", fillcolor="#FBE4E8", color="#EF8B9B"];
  report [label="6. Report Results\nCLI • JSON / SARIF • dashboard", fillcolor="#F0EBFF", color="#9B84F3", width=3.2];
  fix [label="7. Targeted Remediation\nDeveloper/agent proposes a fix", fillcolor="#F0EBFF", color="#9B84F3"];
  rescan [label="8. Rescan & Verify\nConfirm whether the finding is resolved", fillcolor="#D7F7F0", color="#45CDBB"];
  {rank=same; start; detect; run; normalize;}
  {rank=same; pass; fail;}
  {rank=same; fix; rescan;}
  start -> detect -> run -> normalize -> policy;
  policy -> pass [label="meets policy", fontcolor="#256344", fontsize=10];
  policy -> fail [label="violates policy", fontcolor="#8A3545", fontsize=10];
  pass -> report; fail -> report; report -> fix [label="when actionable", fontsize=10, fontcolor="#4E4673"]; fix -> rescan -> run [label="verification loop", color="#9B84F3", fontcolor="#4E4673", fontsize=10, constraint=false];
}
