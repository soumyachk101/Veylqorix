{
  "name": "@veylqorix/cli",
  "version": "0.1.0",
  "description": "Veylqorix command-line interface: run security audits and quality gates from the terminal or CI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.18"
  },
  "main": "dist/index.js",
  "bin": {
    "veylqorix": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@veylqorix/core": "workspace:*"
  }
}
